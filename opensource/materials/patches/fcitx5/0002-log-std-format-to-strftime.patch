+            auto secs =
+                std::chrono::time_point_cast<std::chrono::seconds>(now);
+            auto micros = static_cast<long long>(
+                std::chrono::duration_cast<std::chrono::microseconds>(
+                    now - secs)
+                    .count());
+            std::time_t timeT = std::chrono::system_clock::to_time_t(secs);
+            std::tm tmValue{};
 #if __cpp_lib_chrono >= 201907L
-            const auto *current_zone = std::chrono::current_zone();
-            std::chrono::zoned_time zoned_time{current_zone, now};
-
-            auto timeString = std::format("{:%F %T}", zoned_time);
+            ::localtime_r(&timeT, &tmValue);
 #else
-            auto timeString = std::format("{:%F %T}", now);
+            ::gmtime_r(&timeT, &tmValue);
 #endif
+            char timeBuf[32];
+            std::strftime(timeBuf, sizeof(timeBuf), "%Y-%m-%d %H:%M:%S",
+                          &tmValue);
+            char fracBuf[16];
+            std::snprintf(fracBuf, sizeof(fracBuf), ".%06lld", micros);
+            auto timeString = std::string(timeBuf) + fracBuf;
             out_ << timeString << " ";
         } catch (...) {
         }
