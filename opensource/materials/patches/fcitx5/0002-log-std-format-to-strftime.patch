         try {
             auto now = std::chrono::time_point_cast<std::chrono::microseconds>(
                 std::chrono::system_clock::now());
+            // rukik-ios-compat: std::format("{:%F %T}", ...) replaced
+            // by strftime plus an explicit fractional-seconds suffix.
+            // libc++'s chrono std::format instantiates floating-point
+            // std::to_chars, unavailable below iOS 16.3; this build
+            // targets iOS 13.0. Output is identical:
+            // "YYYY-MM-DD HH:MM:SS.ffffff" -- local time when chrono
