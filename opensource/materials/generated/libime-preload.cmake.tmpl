# rukik libime preload — generated by build-libime-ios.sh (FIX6).
# Injected with CMAKE_PROJECT_INCLUDE: CMake includes this file at the
# end of the top-level project() call, i.e. before libime's
# find_package(Fcitx5Utils ...) (libime/CMakeLists.txt:37). The static
# Fcitx5Utils package's Targets file references the imported targets
# LibIntl::LibIntl, Pthread::Pthread and DL::DL (LINK_ONLY-wrapped) in
# its INTERFACE_LINK_LIBRARIES; loading the package fails unless those
# targets already exist, so define them here with fcitx5's own find
# modules.
if(NOT DEFINED RUKIK_LIBIME_PRELOAD_DONE)
  set(RUKIK_LIBIME_PRELOAD_DONE TRUE)
  list(APPEND CMAKE_MODULE_PATH "$SRC/fcitx5/cmake")
  # Same injection as the Fcitx5Utils configure (FIX4): pre-seeding the
  # two cache variables makes fcitx5's FindLibIntl.cmake take the stub
  # in this platform's prefix verbatim (find_path/find_library skip the
  # search when the cache entry is already set), so the host's macOS
  # libintl can never be picked up here either.
  set(LibIntl_INCLUDE_DIR "$prefix/include" CACHE PATH "" FORCE)
  set(LibIntl_LIBRARY "$prefix/lib/libintl.a" CACHE FILEPATH "" FORCE)
  find_package(LibIntl REQUIRED)
  find_package(Pthread REQUIRED)
  find_package(DL REQUIRED)
endif()
